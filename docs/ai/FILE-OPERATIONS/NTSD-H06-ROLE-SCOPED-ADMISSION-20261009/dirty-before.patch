+                candidate.CharacterInputAll(tick);
+            }
+            long sourceBefore = SourceCoordinateRefreshCount(candidate);
+            long aiReadsBefore = candidate.AiUnifiedSnapshotExecutionReadCountForDiagnostics;
+            double totalFullMs = 0;
