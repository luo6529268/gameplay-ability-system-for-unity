+        [Serializable]
+        internal sealed class ColdPreparation
+        {
+            public string api = "RuntimeHelpers.PrepareMethod + MethodHandle.GetFunctionPointer; no Invoke/delegate/business call";
+            public string[] methods = new string[2];
