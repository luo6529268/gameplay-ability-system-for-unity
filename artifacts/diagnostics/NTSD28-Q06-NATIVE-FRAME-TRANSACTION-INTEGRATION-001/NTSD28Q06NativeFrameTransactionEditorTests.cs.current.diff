+        private const string Witness = "artifacts/diagnostics/NTSD28-Q06-NATIVE-FRAME-STEP-LIFECYCLE-SOURCE-WITNESS-001/frame-step.tsv";
+        private const string Output = "artifacts/diagnostics/NTSD28-Q06-NATIVE-FRAME-TRANSACTION-INTEGRATION-001";
