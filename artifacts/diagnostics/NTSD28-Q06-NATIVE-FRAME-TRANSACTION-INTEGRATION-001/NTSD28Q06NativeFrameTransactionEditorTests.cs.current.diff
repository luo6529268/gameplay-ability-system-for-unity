+        [TestCase("lookup")]
+        [TestCase("next")]
+        [TestCase("counter")]
+        [TestCase("cost")]
+        [TestCase("modifiers")]
+        [TestCase("gates")]
+        [TestCase("terminal14")]
+        [TestCase("type3")]
+        [TestCase("already212")]
+        public void NativeFrameCoreMatchesOriginalWorldFunction(string group)
+        {
+            string[] lines = File.ReadAllLines(Witness);
+            string[] columns = lines[0].Split('\t');
+            int cases = 0;
+            var differences = new List<object>();
+            foreach (string line in lines.Skip(1))
+            {
+                string[] values = line.Split('\t');
+                if (values[0] != group) continue;
+                var row = new Dictionary<string, string>();
+                for (int index = 0; index < columns.Length; index++) row.Add(columns[index], values[index]);
+                using (var fixture = new Fixture(row))
+                {
+                    var entity = fixture.Entity;
+                    entity.BeginNativeC25FrameTickForWorldPass();
+                    try { entity.RunNativeC25FrameBodyForWorldPass(); }
+                    finally { entity.EndNativeC25FrameTickForWorldPass(); }
+                    var actual = new Dictionary<string, double>
+                    {
+                        ["actionOut"] = entity.Frame.N, ["latchOut"] = entity.Trans.WaitCounter,
+                        ["counterOut"] = entity.AttackingCounter, ["facingOut"] = entity.Runtime.IsFacingLeft ? 1 : 0,
+                        ["hpOut"] = entity.Health.HP, ["mpOut"] = entity.Health.PP, ["boundOut"] = entity.Health.HPBound,
+                        ["hpConsumed"] = entity.Runtime.InputHpConsumedTotal34C, ["mpConsumed"] = entity.Runtime.InputMpConsumedTotal350,
+                        ["vxOut"] = entity.Runtime.Vx, ["vyOut"] = entity.Runtime.Vy, ["vzOut"] = entity.Runtime.Vz,
+                        ["soundLatchOut"] = entity.Runtime.NativeSoundActionLatch, ["audioCount"] = fixture.World.PendingSounds.Count,
+                        ["pendingOut"] = entity.Runtime.NativeLifecycleResolutionPending ? 1 : 0,
+                        ["codeOut"] = entity.Runtime.NativeLifecycleCode,
+                    };
+                    entity.ResolveNativeC25LifecycleForWorldPass();
+                    var survivor = fixture.World.FindEntityByRuntimeSlotForQuery(int.Parse(row["slot"], CultureInfo.InvariantCulture));
+                    actual["survives"] = survivor != null ? 1 : 0;
+                    actual["finalAction"] = survivor?.Frame.N ?? -9999;
+                    actual["finalLatch"] = survivor?.Trans.WaitCounter ?? -9999;
+                    actual["finalCollisionAction"] = survivor?.Runtime.PrevFrame2 ?? -9999;
+                    actual["finalPrevious078"] = survivor?.Frame.Prev ?? -9999;
+                    actual["finalStateCode"] = survivor?.Runtime.NativeRuntimeStateCode ?? -9999;
+                    foreach (var pair in actual)
+                    {
+                        double expected = double.Parse(row[pair.Key], CultureInfo.InvariantCulture);
+                        if (pair.Value != expected)
+                            differences.Add(new { caseIndex = cases, field = pair.Key, expected, actual = pair.Value, input = row });
+                    }
+                }
+                cases++;
+            }
+            Directory.CreateDirectory(Output);
+            File.WriteAllText(Path.Combine(Output, group + "-core.json"), JsonConvert.SerializeObject(
+                new { group, cases, differenceCount = differences.Count, differences }, Formatting.Indented));
+            Assert.That(cases, Is.GreaterThan(0));
+            Assert.That(differences.Count, Is.Zero, group + " original World frame differences; see artifact.");
+        }
+
+        [TestCase(857, 857)]
+        [TestCase(998, 998)]
+        [TestCase(999, 0)]
+        [TestCase(1000, -1)]
+        [TestCase(1101, 0)]
+        public void ActualLatePassConsumesTerminalAfterPreviousActionCommit(int next, int expectedAction)
+        {
+            foreach (var mode in new[] { BattleEcsCharacterFrameTickPassMode.Legacy, BattleEcsCharacterFrameTickPassMode.DataOriented })
+            using (var fixture = new Fixture(FindRow("next", ("next", next), ("type", 0), ("y", 0), ("yref", 0))))
+            {
+                fixture.World.ConfigureBattleEcsCharacterFrameTickPassForDiagnostics(mode);
+                fixture.Entity.HitStun = 5;
+                fixture.World.LateEntityUpdateAll(1);
+                var entity = fixture.World.FindEntityByRuntimeSlotForQuery(0);
+                if (expectedAction < 0)
+                {
+                    Assert.That(entity, Is.Null);
+                    Assert.That(fixture.World.ObjectCount, Is.Zero);
+                    continue;
+                }
+                Assert.That(entity.Frame.N, Is.EqualTo(expectedAction));
+                Assert.That(entity.Frame.Prev, Is.EqualTo(next == 999 ? 0 : next));
+                Assert.That(entity.Runtime.NativeLifecycleResolutionPending, Is.False);
+                Assert.That(entity.Runtime.NativeLifecycleCode, Is.Zero);
+                Assert.That(entity.HitStun, Is.EqualTo(4), "Encoded scripted state must not replace render phase.");
+                Assert.That(entity.Runtime.NativeRuntimeStateCode, Is.EqualTo(next == 1101 ? -1 : 0));
+                if (next == 1101)
+                {
+                    Assert.That(entity.Trans.WaitCounter, Is.Zero);
+                    Assert.That(entity.Runtime.PrevFrame2, Is.Zero);
+                }
+            }
+        }
+
+        [Test]
+        public void ActualLateCostFallbackPreservesItsLatchAndOriginalSound()
+        {
+            foreach (var mode in new[] { BattleEcsCharacterFrameTickPassMode.Legacy, BattleEcsCharacterFrameTickPassMode.DataOriented })
+            using (var fixture = new Fixture(FindRow("cost", ("destMp", -9), ("destHp", 0), ("mp", 8), ("hp", 10), ("fallback", 1101))))
+            {
+                fixture.World.ConfigureBattleEcsCharacterFrameTickPassForDiagnostics(mode);
+                fixture.World.LateEntityUpdateAll(1);
+                var entity = fixture.World.FindEntityByRuntimeSlotForQuery(0);
+                Assert.That(entity.Frame.N, Is.Zero);
+                Assert.That(entity.Frame.Prev, Is.EqualTo(1101));
+                Assert.That(entity.Trans.WaitCounter, Is.EqualTo(1101));
+                Assert.That(entity.Runtime.PrevFrame2, Is.Zero);
+                Assert.That(entity.Runtime.NativeRuntimeStateCode, Is.EqualTo(-1));
+                Assert.That(entity.Health.PP, Is.EqualTo(8));
+                Assert.That(entity.Runtime.NativeSoundActionLatch, Is.EqualTo(7));
+                Assert.That(fixture.World.PendingSounds.Select(s => s.Cue), Is.EqualTo(new[] { "current.wav", "destination.wav" }));
+            }
+        }
+
+        private static Dictionary<string, string> FindRow(string group, params (string key, int value)[] conditions)
+        {
+            string[] lines = File.ReadAllLines(Witness);
+            string[] columns = lines[0].Split('\t');
+            foreach (string line in lines.Skip(1))
+            {
+                string[] values = line.Split('\t');
+                if (values[0] != group) continue;
+                var row = columns.Select((c, i) => (c, value: values[i])).ToDictionary(x => x.c, x => x.value);
+                if (conditions.All(c => int.Parse(row[c.key], CultureInfo.InvariantCulture) == c.value)) return row;
+            }
+            throw new InvalidOperationException("Original witness row not found.");
+        }
