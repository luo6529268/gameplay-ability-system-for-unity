+        private sealed class NativeBodySheetGroup
+        {
+            internal string ExpectedSha256;
+            internal readonly List<(int characterId, SpriteFileInfo fileInfo, HashSet<int> ownedEffectivePics)> Members =
+                new List<(int characterId, SpriteFileInfo fileInfo, HashSet<int> ownedEffectivePics)>();
+        }
+
+        private static List<NativeBodySheetGroup> BuildNativeBodySheetGroups(
+            List<(int characterId, SpriteFileInfo fileInfo, HashSet<int> ownedEffectivePics)> files,
+            LoganVisualContentCandidate candidate)
+        {
+            var result = new List<NativeBodySheetGroup>();
+            var groups = new Dictionary<(string path, string hash), NativeBodySheetGroup>();
+            foreach (var item in files)
+            {
+                if (candidate.IsMissingBodySheet(item.fileInfo.filePath)) continue;
+                string path = BattleAtlasLayoutPlanner.NormalizePath(Path.GetFullPath(item.fileInfo.filePath));
+                string hash = candidate.GetImageSha256(item.fileInfo.filePath);
+                // All members belong to this one captured native source and processing policy.
+                var key = (path, hash);
+                if (!groups.TryGetValue(key, out NativeBodySheetGroup group))
+                {
+                    group = new NativeBodySheetGroup { ExpectedSha256 = hash };
+                    groups.Add(key, group);
+                    result.Add(group);
+                }
+                group.Members.Add(item);
+            }
+            return result;
+        }
+
+        private static async UniTask<(int created, int failed)> ProcessNativeBodySheetGroupAsync(
+            NativeBodySheetGroup group, Dictionary<int, List<Sprite>> stagedSprites,
+            HashSet<Sprite> stagedCreatedSprites, HashSet<Texture2D> stagedTextures,
+            List<BattleAtlasSourcePixels> stagedAtlasSources, Dictionary<string, Sprite> clampedSpritesByContent,
+            Dictionary<Sprite, string> clampedSourcePathsBySprite, Action<string> onProgressText,
+            System.Threading.SemaphoreSlim cpuSemaphore, System.Threading.SemaphoreSlim uploadSemaphore,
+            BattleContentSource source, Func<bool> canMaterialize)
+        {
+            bool cpuHeld = true, uploadHeld = false;
+            int created = 0, failed = 0;
+            int affectedDeclarations = group.Members.Count;
+            string filePath = group.Members[0].fileInfo.filePath;
+            try
+            {
+                if (!canMaterialize()) return (0, 0);
+                foreach (var item in group.Members)
+                {
+                    onProgressText?.Invoke(FormatLoadingResourcePath(item.fileInfo.filePath));
+                    if (!canMaterialize()) return (0, 0);
+                }
+                var bmpData = await UniTask.RunOnThreadPool(() =>
+                    BMPLoader.LoadVerifiedImageData(filePath, group.ExpectedSha256));
+                await UniTask.SwitchToMainThread();
+                if (!canMaterialize()) return (0, 0);
+                if (bmpData == null || bmpData.Pixels == null) return (0, affectedDeclarations);
+                var pixels = await UniTask.RunOnThreadPool(() => PrepareBattleSheetPixels(bmpData, source));
+                await UniTask.SwitchToMainThread();
+                if (!canMaterialize()) return (0, 0);
+                var plans = new BodySheetSpritePlan[group.Members.Count];
+                for (int i = 0; i < group.Members.Count; i++)
+                {
+                    var item = group.Members[i];
+                    try
+                    {
+                        plans[i] = PrepareBodySheetSpritePlan(item.fileInfo, item.ownedEffectivePics, bmpData, pixels, source);
+                        if (plans[i] == null) failed++;
+                    }
+                    catch (Exception error)
+                    {
+                        failed++;
+                        Debug.LogError($"处理文件失败: {item.fileInfo.filePath}\n{error.Message}");
+                    }
+                }
+                if (failed > 0 || !canMaterialize()) return (0, failed);
+                cpuSemaphore.Release();
+                cpuHeld = false;
+                await uploadSemaphore.WaitAsync();
+                uploadHeld = true;
+                await UniTask.SwitchToMainThread();
+                if (!canMaterialize()) return (0, 0);
+                Texture2D texture = CreateBodySheetTexture(filePath, bmpData.Width, bmpData.Height,
+                    pixels, stagedTextures, stagedAtlasSources);
+                for (int i = 0; i < group.Members.Count; i++)
+                {
+                    var item = group.Members[i];
+                    if (!canMaterialize()) return (created, 0);
+                    affectedDeclarations = 1;
+                    created += CreateBodySheetSprites(item.fileInfo, item.ownedEffectivePics,
+                        stagedSprites[item.characterId], stagedCreatedSprites, stagedTextures,
+                        stagedAtlasSources, clampedSpritesByContent, clampedSourcePathsBySprite,
+                        plans[i], pixels, texture);
+                }
+                await UniTask.Yield();
+                return (created, 0);
+            }
+            catch (Exception error)
+            {
+                Debug.LogError($"处理文件失败: {filePath}\n{error.Message}");
+                return (created, affectedDeclarations);
+            }
+            finally
+            {
+                if (cpuHeld) cpuSemaphore.Release();
+                if (uploadHeld) uploadSemaphore.Release();
+            }
+        }
+
+        private sealed class BodySheetSpritePlan
+        {
+            internal int Col;
+            internal Rect?[] Rects;
+            internal Dictionary<int, string> ClampedCells;
+        }
+
+        private static BodySheetSpritePlan PrepareBodySheetSpritePlan(
+            SpriteFileInfo fileInfo, ISet<int> ownedEffectivePics, BMPLoader.BmpData bmpData,
+            Color32[] processedSheet, BattleContentSource source)
+        {
+            int textureWidth = bmpData.Width;
+            int textureHeight = bmpData.Height;
+            ResolveEffectiveGrid(
+                fileInfo,
+                textureWidth,
+                textureHeight,
+                out int actualRow,
+                out int actualCol);
+
+            int spriteWidth = fileInfo.width;
+            int spriteHeight = fileInfo.height;
+            int row = actualRow;
+            int col = actualCol;
+
+            Rect?[] spriteRects = BuildIndexedSpriteRects(
+                fileInfo,
+                textureWidth,
+                textureHeight,
+                row,
+                col,
+                allowBeyondGridCapacity: source == null ||
+                                         !source.IsLoganRuntime || !bmpData.IsPng);
+            var clampedCells = new Dictionary<int, string>();
+            if (processedSheet != null && source != null && source.IsLoganRuntime &&
+                bmpData.IsPng && spriteRects != null)
+            {
+                for (int i = 0; i < spriteRects.Length; i++)
+                {
+                    int effectivePic = fileInfo.startFrame + i;
+                    if (ownedEffectivePics == null ||
+                        !ownedEffectivePics.Contains(effectivePic))
+                        continue;
+
+                    int sourceX = checked((i % col) * (spriteWidth + 1));
+                    int sourceY = checked(textureHeight -
+                        (i / col + 1) * (spriteHeight + 1) + 1);
+                    if (sourceX >= 0 && sourceY >= 0 &&
+                        (long)sourceX + spriteWidth <= textureWidth &&
+                        (long)sourceY + spriteHeight <= textureHeight)
+                        continue;
+
+                    clampedCells.Add(i, HashNativeClampedCellPixels(
+                        BuildNativeClampedCellPixels(processedSheet,
+                            textureWidth, textureHeight, sourceX, sourceY,
+                            spriteWidth, spriteHeight), spriteWidth, spriteHeight));
+                }
+            }
+
+            if (processedSheet == null || processedSheet.Length == 0 ||
+                spriteRects == null ||
+                (!spriteRects.Any(rect => rect.HasValue) && clampedCells.Count == 0))
+            {
+                return null;
+            }
+
+            return new BodySheetSpritePlan { Col = col, Rects = spriteRects, ClampedCells = clampedCells };
+        }
+
+        private static Texture2D CreateBodySheetTexture(string filePath, int textureWidth, int textureHeight,
+            Color32[] processedSheet, HashSet<Texture2D> stagedTextures, List<BattleAtlasSourcePixels> stagedAtlasSources)
+        {
+            stagedAtlasSources.Add(new BattleAtlasSourcePixels(
+                filePath,
+                textureWidth,
+                textureHeight,
+                processedSheet));
+            var texture = new Texture2D(textureWidth, textureHeight, TextureFormat.RGBA32, false);
+            texture.filterMode = FilterMode.Point;
+            texture.wrapMode = TextureWrapMode.Clamp;
+            texture.SetPixels32(processedSheet);
+            texture.Apply(false, true);
+            texture.name = System.IO.Path.GetFileNameWithoutExtension(filePath);
+            stagedTextures.Add(texture);
+
+            return texture;
+        }
+
+        private static int CreateBodySheetSprites(SpriteFileInfo fileInfo, ISet<int> ownedEffectivePics,
+            List<Sprite> allSprites, HashSet<Sprite> stagedCreatedSprites, HashSet<Texture2D> stagedTextures,
+            List<BattleAtlasSourcePixels> stagedAtlasSources, Dictionary<string, Sprite> clampedSpritesByContent,
+            Dictionary<Sprite, string> clampedSourcePathsBySprite, BodySheetSpritePlan plan,
+            Color32[] processedSheet, Texture2D texture)
+        {
+            int created = 0;
+            int textureWidth = texture.width, textureHeight = texture.height;
+            int spriteWidth = fileInfo.width, spriteHeight = fileInfo.height, col = plan.Col;
+            Rect?[] spriteRects = plan.Rects;
+            Dictionary<int, string> clampedCells = plan.ClampedCells;
+            for (int i = 0; i < spriteRects.Length; i++)
+            {
+                int targetIndex = fileInfo.startFrame + i;
+                if (targetIndex < 0 || targetIndex >= allSprites.Count || targetIndex > fileInfo.endFrame)
+                    continue;
+                if (ownedEffectivePics == null || !ownedEffectivePics.Contains(targetIndex))
+                    continue;
+
+                if (clampedCells.TryGetValue(i, out string clampedHash))
+                {
+                    if (clampedSpritesByContent == null || clampedSourcePathsBySprite == null)
+                        throw new InvalidOperationException("Native clamped-cell publication ownership is missing.");
+                    if (!clampedSpritesByContent.TryGetValue(clampedHash,
+                            out Sprite clampedSprite))
+                    {
+                        int sourceX = checked((i % col) * (spriteWidth + 1));
+                        int sourceY = checked(textureHeight -
+                            (i / col + 1) * (spriteHeight + 1) + 1);
+                        Color32[] clampedPixels = BuildNativeClampedCellPixels(
+                            processedSheet, textureWidth, textureHeight,
+                            sourceX, sourceY, spriteWidth, spriteHeight);
+                        var clampedTexture = new Texture2D(
+                            spriteWidth, spriteHeight, TextureFormat.RGBA32, false);
+                        clampedTexture.filterMode = FilterMode.Point;
+                        clampedTexture.wrapMode = TextureWrapMode.Clamp;
+                        stagedTextures.Add(clampedTexture);
+                        clampedTexture.SetPixels32(clampedPixels);
+                        clampedTexture.Apply(false, true);
+                        clampedTexture.name = "native_clamp_" + clampedHash.Substring(0, 12);
+                        var fullCell = new Rect(0, 0, spriteWidth, spriteHeight);
+                        clampedSprite = Sprite.Create(clampedTexture, fullCell,
+                            new Vector2(0.5f, 0f), 100f, 0, SpriteMeshType.FullRect);
+                        stagedCreatedSprites.Add(clampedSprite);
+                        string virtualPath = NativeClampedCellSourcePath(clampedHash);
+                        stagedAtlasSources.Add(new BattleAtlasSourcePixels(
+                            virtualPath, spriteWidth, spriteHeight, clampedPixels));
+                        clampedSourcePathsBySprite.Add(clampedSprite, virtualPath);
+                        clampedSpritesByContent.Add(clampedHash, clampedSprite);
+                    }
+                    allSprites[targetIndex] = clampedSprite;
+                    created++;
+                    continue;
+                }
+
+                Rect? spriteRect = spriteRects[i];
+                if (!spriteRect.HasValue)
+                    continue;
+
+                Vector2 pivot = ComputeIndexedSpritePivot(
+                    fileInfo,
+                    textureWidth,
+                    textureHeight,
+                    col,
+                    i,
+                    spriteRect.Value);
+                Sprite sprite = Sprite.Create(
+                    texture,
+                    spriteRect.Value,
+                    pivot,
+                    100f,
+                    0,
+                    SpriteMeshType.FullRect
+                );
+                sprite.name = $"sprite_{i / col}_{i % col}";
+                stagedCreatedSprites.Add(sprite);
+                allSprites[targetIndex] = sprite;
+                created++;
+            }
+            return created;
+        }
