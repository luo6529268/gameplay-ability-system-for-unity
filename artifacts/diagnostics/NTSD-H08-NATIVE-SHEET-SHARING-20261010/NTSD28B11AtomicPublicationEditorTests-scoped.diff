+                new Color32(255, 0, 0, 255),
+                new Color32(0, 0, 0, 0),
+                new Color32(0, 0, 255, 255),
+                new Color32(0, 0, 0, 0),
+                new Color32(0, 255, 0, 255),
+                new Color32(255, 255, 0, 128),
+                new Color32(0, 0, 0, 0),
+                new Color32(255, 255, 255, 255),
+            };
