+                for (int mip = 0; mip < mipCount; mip++)
+                {
+                    bytes = checked(bytes + BattleImageMemoryBudget.PixelBytes(width, height) * depth * (readable ? 2 : 1));
+                    width = Math.Max(1, width / 2); height = Math.Max(1, height / 2);
+                }
+            }
+            return bytes;
+        }
