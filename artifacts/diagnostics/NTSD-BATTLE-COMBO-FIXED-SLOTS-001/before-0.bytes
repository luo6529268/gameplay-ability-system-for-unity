using System;
using System.Collections;
using MoreMountains.Feedbacks;
using MoreMountains.Tools;
using NTSD.Simulation;
using UnityEngine;
using UnityEngine.UI;

namespace NTSD.UI.Battle
{
    public sealed class BattleComboView : MonoBehaviour, MMEventListener<BattleComboInputChangedEvent>
    {
        [Serializable]
        private struct KeyIcon
        {
            public BattleInputHistoryKey Key;
            public Sprite Sprite;
        }

        [SerializeField] private RectTransform comboBackgroundImage;
        [SerializeField] private RectTransform comboContentImage;
        [SerializeField] private RectTransform comboArrowImage;
        [SerializeField] private KeyIcon[] keyIcons = Array.Empty<KeyIcon>();
        [SerializeField] private float defaultWidth = 406f;
        [SerializeField] private float horizontalPadding = 80f;
        [SerializeField] private float consumedDisplaySeconds = .5f;

        private static readonly BattleInputHistoryKey[] Keys =
        {
            BattleInputHistoryKey.Right, BattleInputHistoryKey.Left, BattleInputHistoryKey.Up,
            BattleInputHistoryKey.Down, BattleInputHistoryKey.Attack, BattleInputHistoryKey.Jump, BattleInputHistoryKey.Defend,
        };
        private readonly Sprite[] sprites = new Sprite[10];
        private readonly Image[] icons = new Image[BattleComboInputChangedEvent.Capacity];
        private readonly RectTransform[] arrows = new RectTransform[BattleComboInputChangedEvent.Capacity - 1];
        private MMMiniObjectPooler iconPool;
        private MMMiniObjectPooler arrowPool;
        private VisualSettings iconSettings;
        private VisualSettings arrowSettings;
        private Transform visualParent;
        private bool initialized;
        private bool listening;
        private float contentY;
        private float arrowY;
        private Coroutine pendingClear;

        private void OnEnable()
        {
            InitializeVisuals();
            if (!listening)
            {
                this.MMEventStartListening<BattleComboInputChangedEvent>();
                listening = true;
            }
            ClearVisualState();
            SimulationTickDriver driver = SimulationTickDriver.Instance;
            if (driver != null && driver.TryGetCurrentBattleComboInput(out var value)) Apply(value);
        }

        private void OnDisable()
        {
            StopListening();
            ClearVisualState();
        }

        private void OnDestroy()
        {
            StopListening();
            CancelPendingClear();
            ClearVisualState();
            DestroyPool(ref iconPool);
            DestroyPool(ref arrowPool);
        }

        private void StopListening()
        {
            if (!listening) return;
            this.MMEventStopListening<BattleComboInputChangedEvent>();
            listening = false;
        }

        private bool BuildIconMap()
        {
            Array.Clear(sprites, 0, sprites.Length);
            bool valid = true;
            int assigned = 0;
            foreach (KeyIcon entry in keyIcons ?? Array.Empty<KeyIcon>())
            {
                int key = (int)entry.Key;
                if (Array.IndexOf(Keys, entry.Key) < 0 || (assigned & (1 << key)) != 0)
                {
                    Debug.LogWarning("[BattleComboView] Invalid or duplicate icon key: " + entry.Key, this);
                    valid = false;
                    continue;
                }
                assigned |= 1 << key;
                sprites[key] = entry.Sprite;
            }
            foreach (BattleInputHistoryKey key in Keys)
            {
                if (sprites[(int)key] != null) continue;
                Debug.LogWarning("[BattleComboView] Missing icon: " + key, this);
                valid = false;
            }
            return valid;
        }

        private void InitializeVisuals()
        {
            if (initialized || comboContentImage == null || comboArrowImage == null) return;
            Image icon = comboContentImage.GetComponent<Image>();
            Image arrow = comboArrowImage.GetComponent<Image>();
            if (icon == null || arrow == null)
            {
                Debug.LogError("[BattleComboView] Both pool templates require an Image component.", this);
                return;
            }
            BuildIconMap();
            visualParent = comboContentImage.parent;
            comboArrowImage.SetParent(visualParent, true);
            contentY = comboContentImage.anchoredPosition.y;
            arrowY = comboArrowImage.anchoredPosition.y;
            icons[0] = icon;
            arrows[0] = comboArrowImage;
            iconSettings = new VisualSettings(comboContentImage);
            arrowSettings = new VisualSettings(comboArrowImage);
            iconPool = CreatePool("Combo icon pool", comboContentImage, icons.Length - 1);
            arrowPool = CreatePool("Combo arrow pool", comboArrowImage, arrows.Length - 1);
            initialized = true;
        }

        private MMMiniObjectPooler CreatePool(string poolName, RectTransform template, int capacity)
        {
            var owner = new GameObject(poolName);
            owner.transform.SetParent(transform, false);
            var pool = owner.AddComponent<MMMiniObjectPooler>();
            pool.GameObjectToPool = template.gameObject;
            pool.PoolSize = capacity;
            pool.PoolCanExpand = false;
            pool.MutualizeWaitingPools = false;
            pool.NestWaitingPool = true;
            pool.FillObjectPool();
            return pool;
        }

        private RectTransform Borrow(MMMiniObjectPooler pool, VisualSettings settings)
        {
            if (pool == null) return null;
            GameObject instance = pool.GetPooledGameObject();
            if (instance == null)
            {
                Debug.LogError("[BattleComboView] UI pool exhausted; no unpooled fallback is allowed.", this);
                return null;
            }
            var rect = (RectTransform)instance.transform;
            rect.SetParent(visualParent, false);
            settings.Restore(rect, false);
            // The existing pool treats inactive objects as available. Activate before borrowing another.
            instance.SetActive(true);
            return rect;
        }

        private static void Return(RectTransform rect, MMMiniObjectPooler pool, VisualSettings settings)
        {
            if (rect == null) return;
            rect.gameObject.SetActive(false);
            if (pool != null) rect.SetParent(pool.transform, false);
            settings.Restore(rect, true);
        }

        private void ReturnIcon(int index)
        {
            Image image = icons[index];
            icons[index] = null;
            if (image != null) Return(image.rectTransform, iconPool, iconSettings);
        }

        private void ReturnArrow(int index)
        {
            RectTransform rect = arrows[index];
            arrows[index] = null;
            Return(rect, arrowPool, arrowSettings);
        }

        private static void DestroyPool(ref MMMiniObjectPooler pool)
        {
            if (pool == null) return;
            pool.DestroyObjectPool();
            Destroy(pool.gameObject);
            pool = null;
        }

        private sealed class VisualSettings
        {
            private readonly Vector2 anchorMin, anchorMax, pivot, size;
            private readonly Vector3 position, scale;
            private readonly Quaternion rotation;
            private readonly Sprite sprite;
            private readonly Color color;
            private readonly Material material;
            private readonly Image.Type type;
            private readonly Image.FillMethod fillMethod;
            private readonly float fillAmount, pixelsPerUnit;
            private readonly int fillOrigin;
            private readonly bool preserveAspect, fillCenter, fillClockwise, useSpriteMesh, maskable;
            private readonly bool hasLayout, layoutEnabled, ignoreLayout;
            private readonly float minWidth, minHeight, preferredWidth, preferredHeight, flexibleWidth, flexibleHeight;
            private readonly int layoutPriority;

            internal VisualSettings(RectTransform rect)
            {
                anchorMin = rect.anchorMin; anchorMax = rect.anchorMax; pivot = rect.pivot;
                size = rect.sizeDelta; position = rect.anchoredPosition3D;
                scale = rect.localScale; rotation = rect.localRotation;
                Image image = rect.GetComponent<Image>();
                sprite = image.sprite; color = image.color; material = image.material;
                type = image.type; preserveAspect = image.preserveAspect; fillCenter = image.fillCenter;
                fillMethod = image.fillMethod; fillAmount = image.fillAmount; fillOrigin = image.fillOrigin;
                fillClockwise = image.fillClockwise; useSpriteMesh = image.useSpriteMesh;
                pixelsPerUnit = image.pixelsPerUnitMultiplier; maskable = image.maskable;
                LayoutElement layout = rect.GetComponent<LayoutElement>();
                hasLayout = layout != null;
                if (!hasLayout) return;
                layoutEnabled = layout.enabled; ignoreLayout = layout.ignoreLayout;
                minWidth = layout.minWidth; minHeight = layout.minHeight;
                preferredWidth = layout.preferredWidth; preferredHeight = layout.preferredHeight;
                flexibleWidth = layout.flexibleWidth; flexibleHeight = layout.flexibleHeight;
                layoutPriority = layout.layoutPriority;
            }

            internal void Restore(RectTransform rect, bool clearSprite)
            {
                rect.anchorMin = anchorMin; rect.anchorMax = anchorMax; rect.pivot = pivot;
                rect.sizeDelta = size; rect.anchoredPosition3D = position;
                rect.localScale = scale; rect.localRotation = rotation;
                Image image = rect.GetComponent<Image>();
                image.overrideSprite = null; image.sprite = clearSprite ? null : sprite;
                image.color = color; image.material = material; image.type = type;
                image.preserveAspect = preserveAspect; image.fillCenter = fillCenter;
                image.fillMethod = fillMethod; image.fillAmount = fillAmount; image.fillOrigin = fillOrigin;
                image.fillClockwise = fillClockwise; image.useSpriteMesh = useSpriteMesh;
                image.pixelsPerUnitMultiplier = pixelsPerUnit; image.maskable = maskable;
                image.raycastTarget = false; image.enabled = true; image.canvasRenderer.SetAlpha(1f);
                if (!hasLayout) return;
                LayoutElement layout = rect.GetComponent<LayoutElement>();
                layout.enabled = layoutEnabled; layout.ignoreLayout = ignoreLayout;
                layout.minWidth = minWidth; layout.minHeight = minHeight;
                layout.preferredWidth = preferredWidth; layout.preferredHeight = preferredHeight;
                layout.flexibleWidth = flexibleWidth; layout.flexibleHeight = flexibleHeight;
                layout.layoutPriority = layoutPriority;
            }
        }

        public void OnMMEvent(BattleComboInputChangedEvent value)
        {
            if (!isActiveAndEnabled) return;
            SimulationTickDriver driver = SimulationTickDriver.Instance;
            if (driver != null && driver.IsCurrentBattleComboInputEvent(value)) Apply(value);
        }

        private void Apply(BattleComboInputChangedEvent value)
        {
            CancelPendingClear();
            if (!initialized) { ClearVisualState(); return; }
            int count = value.Binding.IsVisible ? value.Count : 0;
            double remaining = consumedDisplaySeconds - (Time.unscaledTimeAsDouble - value.PublishedAt);
            if (value.Kind == BattleComboInputChangeKind.Consumed && remaining <= 0) count = 0;
            Render(value, count);
            if (count > 0 && value.Kind == BattleComboInputChangeKind.Consumed)
                pendingClear = StartCoroutine(ClearAfter((float)remaining));
        }

        private IEnumerator ClearAfter(float seconds)
        {
            yield return new WaitForSecondsRealtime(seconds);
            pendingClear = null;
            ClearVisualState();
        }

        private void CancelPendingClear()
        {
            if (pendingClear == null) return;
            StopCoroutine(pendingClear);
            pendingClear = null;
        }

        private void Render(BattleComboInputChangedEvent value, int count)
        {
            float iconWidth = comboContentImage.rect.width;
            float step = iconWidth + comboArrowImage.rect.width;
            float rowWidth = count > 0 ? iconWidth + (count - 1) * step : 0f;
            float start = -(rowWidth - iconWidth) * .5f;
            for (int i = 0; i < icons.Length; i++)
            {
                int key = i < count ? (int)value.GetKey(i) : -1;
                Sprite sprite = key >= 0 && key < sprites.Length ? sprites[key] : null;
                if (sprite == null)
                {
                    if (i > 0) ReturnIcon(i);
                    else icons[0].gameObject.SetActive(false);
                    continue;
                }
                if (i > 0 && icons[i] == null)
                {
                    RectTransform borrowed = Borrow(iconPool, iconSettings);
                    if (borrowed != null) icons[i] = borrowed.GetComponent<Image>();
                }
                if (icons[i] == null) continue;
                if (i == 0) iconSettings.Restore(comboContentImage, false);
                icons[i].overrideSprite = null;
                icons[i].sprite = sprite;
                icons[i].gameObject.SetActive(true);
                icons[i].rectTransform.anchoredPosition = new Vector2(start + i * step, contentY);
            }
            for (int i = 0; i < arrows.Length; i++)
            {
                bool visible = i + 1 < count && icons[i] != null && icons[i + 1] != null &&
                    icons[i].gameObject.activeSelf && icons[i + 1].gameObject.activeSelf;
                if (!visible)
                {
                    if (i > 0) ReturnArrow(i);
                    else arrows[0].gameObject.SetActive(false);
                    continue;
                }
                if (i > 0 && arrows[i] == null) arrows[i] = Borrow(arrowPool, arrowSettings);
                if (arrows[i] == null) continue;
                if (i == 0) arrowSettings.Restore(comboArrowImage, false);
                arrows[i].gameObject.SetActive(true);
                arrows[i].anchoredPosition = new Vector2(start + (i + .5f) * step, arrowY);
            }
            float singleKeyWidth = Mathf.Max(defaultWidth, iconWidth + 2f * horizontalPadding);
            SetBackgroundWidth(count > 0 ? singleKeyWidth + (count - 1) * step : defaultWidth);
        }

        private void SetBackgroundWidth(float width)
        {
            if (comboBackgroundImage == null) return;
            comboBackgroundImage.gameObject.SetActive(true);
            Image background = comboBackgroundImage.GetComponent<Image>();
            if (background != null) background.enabled = true;
            comboBackgroundImage.SetSizeWithCurrentAnchors(RectTransform.Axis.Horizontal, width);
        }

        public void ClearVisualState()
        {
            CancelPendingClear();
            if (comboContentImage != null) comboContentImage.gameObject.SetActive(false);
            if (comboArrowImage != null) comboArrowImage.gameObject.SetActive(false);
            for (int i = 1; i < icons.Length; i++) ReturnIcon(i);
            for (int i = 1; i < arrows.Length; i++) ReturnArrow(i);
            if (initialized)
            {
                if (comboContentImage != null) iconSettings.Restore(comboContentImage, true);
                if (comboArrowImage != null) arrowSettings.Restore(comboArrowImage, true);
            }
            SetBackgroundWidth(defaultWidth);
        }
    }
}
