        "+            var configs = CharacterAnimtorManager.BuildCharacterFrameConfigsFromCatalog(catalog);",
        "+            Assert.That(configs[objectId].characterData.frames.Any(frame =>",
        "+                frame.frameId == frameId && frame.hit_Fa == hitFa), Is.True);",
        "+",
