+        [Test]
+        public void NativeSkillRecoveryAndSpawnPublishCanonicalResourceValues()
+        {
+            var idle = new LF2FrameData { frameId = 0, state = 0 };
+            var skill = new LF2FrameData { frameId = 1, state = 3, mp = 75, cmp = 20, chp = 9 };
+            var data = new LF2CharacterData
+            {
+                type_sub = 0,
+                frames = new List<LF2FrameData> { idle, skill },
+            };
+            var character = new LF2Character();
+            var cache = new LF2FrameCache();
+            typeof(LF2Character).GetProperty("FrameCache",
+                BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic)
+                .SetValue(character, cache);
+            var config = new LF2CharacterDataWrapper(1, data);
+            cache.Load(config);
+            var world = new SimulationWorld();
+            world.RuntimeDataCatalog.Prepare(
+                new[] { new ObjectDefinition { id = 1, type = 0 } }, _ => config);
+            world.RuntimeDataCatalog.Seal();
+            typeof(LF2Entity).GetField("registeredWorld", BindingFlags.Instance | BindingFlags.NonPublic)
+                .SetValue(character, world);
+            character.Runtime.ObjectId = 1;
+            character.Frame.D = idle;
+            character.Frame.N = 0;
+            character.Runtime.InputLocalResourceEnabled49D034 = true;
+            character.Runtime.PP = 300;
+            character.Runtime.MP = 500;
+            var tracker = new BattleHudChangeTracker();
+            tracker.Bind(0, character.Runtime, new RuntimeEntityHandle(0, 1));
+            tracker.TryConsume(out var initial);
+            Assert.That(initial.Mp, Is.EqualTo(300));
+
+            Assert.That(new BattleCharacterActionWriter().ApplyNativeInputAction(character, 1).Applied, Is.True);
+            Assert.That(tracker.TryConsume(out var spent), Is.True);
+            Assert.That(spent.Mp, Is.EqualTo(225));
+            Assert.That(spent.Changes, Is.EqualTo(BattleHudChanges.Mp));
+            character.Runtime.MP = 9;
+            Assert.That(tracker.TryConsume(out _), Is.False, "Legacy MP must not corrupt the blue resource cache.");
+
+            BattleRecoveryStatusWriter.ApplyMpRecovery(character, 0, 1, false);
+            Assert.That(tracker.TryConsume(out var recovered), Is.True);
+            Assert.That(recovered.Mp, Is.EqualTo(245));
+            Assert.That(recovered.Changes, Is.EqualTo(BattleHudChanges.Mp));
+
+            character.Health.HP = 400;
+            character.Health.HPBound = 450;
+            tracker.TryConsume(out _);
+            BattleRecoveryStatusWriter.ApplyHpRecovery(character, 0, 1);
+            Assert.That(tracker.TryConsume(out var healed), Is.True);
+            Assert.That(healed.Hp, Is.EqualTo(409));
+            Assert.That(healed.HpBound, Is.EqualTo(453));
+            Assert.That(healed.Changes, Is.EqualTo(BattleHudChanges.Hp | BattleHudChanges.HpBound));
+
+            BattleSpawnVitalsWriter.Apply(character, new ObjectPoint { hp = 150, mp = 180 });
+            Assert.That(tracker.TryConsume(out var spawned), Is.True);
+            Assert.That(spawned.HpMax, Is.EqualTo(150));
+            Assert.That(spawned.Mp, Is.EqualTo(180));
+            Assert.That(spawned.MpMax, Is.EqualTo(180));
+            tracker.Reset(stop: true);
+        }
