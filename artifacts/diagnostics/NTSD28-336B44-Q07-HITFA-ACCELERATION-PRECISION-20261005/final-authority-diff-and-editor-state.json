        "-                Runtime.Vx -= 0.7f;",
        "+                Runtime.Vx -= 0.7;",
        "             if (targetZ > selfZ + 5)",
        "-                Runtime.Vz += 0.4f;",
        "+                Runtime.Vz += 0.4;",
        "             if (targetZ < selfZ - 5)",
        "-                Runtime.Vz -= 0.4f;",
        "+                Runtime.Vz -= 0.4;",
        " ",
