        "+                        entity.Runtime.SyncIntegerPosition();",
        "+                        entity.Runtime.SetSourceRulePosition(400, sourceZ);",
        "+                        entity.Runtime.SyncSourceRuleIntegerPosition();",
        "+                        entity.Runtime.SetVelocity(0, 0, 0);",
        "+                    }",
        "+",
        "+                    Place(subject, -100, 600);",
        "+                    Place(target, 0, 604);",
